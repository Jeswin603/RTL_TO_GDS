#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x57f0e798fb70 .scope module, "Testbench" "Testbench" 2 2;
 .timescale -9 -12;
v0x57f0e79a1110_0 .var "Clock", 0 0;
v0x57f0e79a11e0_0 .net "Count", 3 0, v0x57f0e79a0f10_0;  1 drivers
v0x57f0e79a12b0_0 .var "Reset", 0 0;
S_0x57f0e798fd00 .scope module, "I1" "Mycounter" 2 8, 3 1 0, S_0x57f0e798fb70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "CLK";
    .port_info 1 /INPUT 1 "RST";
    .port_info 2 /OUTPUT 4 "OUT";
v0x57f0e7956490_0 .net "CLK", 0 0, v0x57f0e79a1110_0;  1 drivers
v0x57f0e79a0f10_0 .var "OUT", 3 0;
v0x57f0e79a0ff0_0 .net "RST", 0 0, v0x57f0e79a12b0_0;  1 drivers
E_0x57f0e7956b30 .event posedge, v0x57f0e7956490_0;
    .scope S_0x57f0e798fd00;
T_0 ;
    %wait E_0x57f0e7956b30;
    %load/vec4 v0x57f0e79a0ff0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x57f0e79a0f10_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x57f0e79a0f10_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x57f0e79a0f10_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x57f0e798fb70;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57f0e79a1110_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x57f0e798fb70;
T_2 ;
    %delay 50000, 0;
    %load/vec4 v0x57f0e79a1110_0;
    %inv;
    %store/vec4 v0x57f0e79a1110_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x57f0e798fb70;
T_3 ;
    %vpi_call 2 13 "$dumpfile", "count.vcd" {0 0 0};
    %vpi_call 2 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57f0e798fb70 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57f0e79a12b0_0, 0, 1;
    %delay 100000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57f0e79a12b0_0, 0, 1;
    %delay 2000000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57f0e79a12b0_0, 0, 1;
    %delay 400000, 0;
    %vpi_call 2 20 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "Testbench.v";
    "Mycounter.v";
